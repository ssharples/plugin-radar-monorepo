+    std::atomic<bool> readerOK{true};
+    std::thread producer([&]
+    {
+        juce::AudioBuffer<float> block(2, 64);
+        while (running.load(std::memory_order_relaxed))
+        {
+            block.clear();
+            for (int i = 0; i < block.getNumSamples(); ++i)
+                block.getWritePointer(0)[i] = block.getWritePointer(1)[i] = 0.2f;
