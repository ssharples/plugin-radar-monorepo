{
  "name": "plugin-radar-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PluginRadar \u2014 Audio plugin database, price tracker, and chain manager",
  "author": "Scott Sharples",
  "license": "MIT",
  "scripts": {
    "dev:convex": "npx convex dev",
    "deploy": "npx convex deploy",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:desktop-ui": "pnpm --filter desktop-ui dev",
    "build:desktop-ui": "pnpm --filter desktop-ui build",
    "install:all": "pnpm install",
    "quality:setup": "python3 tools/quality/bootstrap.py",
    "quality:test": "python3 tools/quality/run.py test",
    "crap": "python3 tools/quality/run.py crap",
    "mutate": "python3 tools/quality/run.py mutate",
    "quality:gate": "python3 tools/quality/run.py gate",
    "quality:scope": "python3 tools/quality/run.py scope",
    "quality:mutation-config": "python3 tools/quality/run.py mutation-config"
  },
  "dependencies": {
    "convex": "^1.31.7",
    "exa-js": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.9"
}
